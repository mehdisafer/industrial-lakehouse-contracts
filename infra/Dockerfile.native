# Candidate native image. Not built or qualified in the offline authoring session.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml /app/
COPY src /app/src
RUN python -m pip install --no-cache-dir '.[native,test]'
COPY . /app
ENV SPARK_LOCAL_IP=127.0.0.1 TZ=UTC
CMD ["python", "scripts/qualify_native.py", "--output", "/work/native"]
